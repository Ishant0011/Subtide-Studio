# Public Supabase project configuration (safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-or-project-anon-key

# Social OAuth provider UI flags (set to "true" ONLY after enabling the provider in Supabase)
# Keep OAuth client secrets strictly in your Supabase Dashboard — never commit them here.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_DISCORD_ENABLED=false

# Privileged server-only key — NEVER expose to the browser or prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-or-project-service-role-key

# Phase 3 Worker & Transcription (server/worker-only)
# Set TRANSCRIPTION_ADAPTER=fixture for deterministic local testing, or deepgram / auto when DEEPGRAM_API_KEY is set
TRANSCRIPTION_ADAPTER=auto
DEEPGRAM_API_KEY=

# Optional explicit binary paths for native Windows worker execution
FFMPEG_PATH=
FFPROBE_PATH=
